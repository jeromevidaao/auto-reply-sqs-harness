# Copy this file to .env and fill in real values when you want to call live Grok
GROK_API_KEY=your_xai_api_key_here

# Optional: when you later wire real Hospitable calls in the harness (for advanced evals)
# HOSPITABLE_BEARER_TOKEN=...     # Preferred for local/manual testing (falls back to SSM in prod)

# KumoCloud (Mitsubishi heat pump API) creds for live status + auto-remediation of mixed modes
# KUMO_EMAIL=...                  # Falls back to SSM /kumocloud/email in Lambda
# KUMO_PASSWORD=...               # Falls back to SSM /kumocloud/password (secret) in Lambda
# For local testing of the Kathryn-style "no air but remotes on" mixed-mode case, set these
# or the HeatPumpTool will return graceful no-data responses.

# Google Maps (Routes API) key for live driving + walking times (Old Port, downtown, "how far" questions).
# Falls back to mock data in GoogleMapsTool if absent. In Lambda it can also come from SSM /google/maps-api-key.
# GOOGLE_MAPS_API_KEY=...

# To get a fresh real conversation_id for escalation test messages (instead of any hard-coded value):
#   node scripts/get-real-conversation-id.js <listing-uuid>
# Or run the getReservations() method directly. See HospitableClient.js and the linked docs.

# Urgent access SMS (door lockout / APT2_STREET_DOOR_LOCKOUT / lockbox) via SNS.
# Prefer a dedicated topic with SMS subscriptions for Jerome + Ruby, OR direct phone numbers:
# URGENT_ACCESS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:ACCOUNT:urgent-guest-access
# URGENT_ACCESS_PHONE_NUMBER=+16462043958,+15086676477
