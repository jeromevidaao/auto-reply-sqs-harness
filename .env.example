# Copy this file to .env and fill in real values when you want to call live Grok
GROK_API_KEY=your_xai_api_key_here

# Optional: when you later wire real Hospitable calls in the harness (for advanced evals)
# HOSPITABLE_BEARER_TOKEN=...     # Preferred for local/manual testing (falls back to SSM in prod)

# KumoCloud (Mitsubishi heat pump API) creds for live status + auto-remediation of mixed modes
# KUMO_EMAIL=...                  # Falls back to SSM /kumocloud/email in Lambda
# KUMO_PASSWORD=...               # Falls back to SSM /kumocloud/password (secret) in Lambda

# Google Maps (Routes API) key for live driving + walking times.
# Falls back to mock data in GoogleMapsTool if absent. In Lambda: SSM /google/maps-api-key.
# GOOGLE_MAPS_API_KEY=...

# Host phones, WiFi, lockbox codes — NEVER commit real values.
# Production Lambda loads SSM SecureString /host/contacts-json.
# Local options (pick one):
# HOST_CONTACTS_JSON={"jeromePhoneDisplay":"...","rubyPhoneDisplay":"...","richardPhonePrimary":"...","wifiSsid":"...","wifiPassword":"...","ownerEmail":"...","urgentAccessE164":"+1...,+1...","apt2StreetLockboxCode":"...","propertyManagerName":"Richard"}
# Or individual env vars: HOST_JEROME_PHONE, HOST_RUBY_PHONE, HOST_RICHARD_PHONE_PRIMARY, WIFI_SSID, WIFI_PASSWORD, OWNER_EMAIL, URGENT_ACCESS_PHONE_NUMBER, APT2_STREET_LOCKBOX_CODE
# Unit tests set ALLOW_HOST_CONTACT_TEST_DEFAULTS=1 (synthetic 555 numbers only).

# Urgent access SMS (door lockout) via SNS topic and/or E.164 list from host contacts:
# URGENT_ACCESS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:ACCOUNT:urgent-guest-access-alerts
